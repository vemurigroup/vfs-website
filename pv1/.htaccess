# Security headers + HTTPS enforcement for the public marketing site.
# backoffice/ has its own .htaccess (plus PHP-level sendSecurityHeaders()
# in inc/auth.php) — this file covers everything outside backoffice/,
# which previously had no .htaccess at all: no forced HTTPS, no security
# headers of any kind.
#
# CSP is deliberately NOT set here, same reasoning as documented in
# backoffice/inc/auth.php: this site has multiple inline <script> blocks
# (quiz, calculators, review form, FAB cluster) that would need a
# nonce/hash audit first — tightening blind risks silently breaking
# working pages. Tracked as a follow-up, not guessed at here.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS: only meaningful once HTTPS is confirmed reliably serving (GoDaddy
    # shared hosting includes free SSL, matching backoffice/.htaccess's own
    # force-HTTPS rule below). 6 months, no preload/includeSubDomains yet —
    # preload is a one-way commitment that's hard to reverse if a future
    # subdomain needs plain HTTP; add it deliberately later, not by default.
    Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (GoDaddy shared hosting includes free SSL) — matches
    # backoffice/.htaccess's identical rule.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

Options -Indexes
